import re
from dataclasses import dataclass
from typing import Any, Dict, Optional

FLEET_REGISTRY: Dict[str, Dict[str, Any]] = {
    "system_kernel": {
        "routing_domain": "infrastructure",
        "aperture_floor": 0.20,
        "system_override": "You are the automated system kernel core. Focus on low-level architectural execution, state diagnostics, and dynamic optimization handshakes.",
        "priority": "high",
        "memory_scope": "local",
        "stream_mode": False,
    },
    "narrative_engine": {
        "routing_domain": "creative",
        "aperture_floor": 0.45,
        "system_override": "You are the narrative story engine. Focus on continuity, autonomous ship tracking, deep world-building parameters, and terraforming lore.",
        "priority": "normal",
        "memory_scope": "global",
        "stream_mode": False,
    },
    "default_assistant": {
        "routing_domain": "general",
        "aperture_floor": 0.10,
        "system_override": "You are a local context-managed assistant. Provide concise, accurate responses.",
        "priority": "normal",
        "memory_scope": "local",
        "stream_mode": False,
    },
}

ROUTING_RULES = [
    (re.compile(r"\b(kernel|handshake|initialization|handoff|bridge|infrastructure)\b", re.IGNORECASE), "system_kernel"),
    (re.compile(r"\b(story|narrative|ship|autonomous|terraforming|novel|lore)\b", re.IGNORECASE), "narrative_engine"),
]

@dataclass
class RouterResult:
    target_persona: str
    routing_domain: str
    aperture_floor: float
    system_override: str
    payload: str
    priority: str
    memory_scope: str
    stream_mode: bool
    version: str = "1.0"

    def to_dict(self) -> Dict[str, Any]:
        return {
            "target_persona": self.target_persona,
            "routing_domain": self.routing_domain,
            "aperture_floor": self.aperture_floor,
            "system_override": self.system_override,
            "payload": self.payload,
            "priority": self.priority,
            "memory_scope": self.memory_scope,
            "stream_mode": self.stream_mode,
            "version": self.version,
        }

class OllamaFleetRouter:
    def __init__(self, registry: Optional[Dict[str, Dict[str, Any]]] = None):
        self.registry = registry or FLEET_REGISTRY
        self.routing_rules = ROUTING_RULES

    def classify_intent(self, prompt: str) -> str:
        for pattern, persona_key in self.routing_rules:
            if pattern.search(prompt):
                return persona_key
        return "default_assistant"

    def build_envelope(self, raw_prompt: str) -> Dict[str, Any]:
        persona_key = self.classify_intent(raw_prompt)
        config = self.registry.get(persona_key, self.registry["default_assistant"])
        result = RouterResult(
            target_persona=persona_key,
            routing_domain=config["routing_domain"],
            aperture_floor=float(config["aperture_floor"]),
            system_override=str(config["system_override"]),
            payload=raw_prompt,
            priority=str(config["priority"]),
            memory_scope=str(config["memory_scope"]),
            stream_mode=bool(config["stream_mode"]),
        )
        return result.to_dict()

    def route_request(self, raw_prompt: str) -> Dict[str, Any]:
        return self.build_envelope(raw_prompt)
    # --- RUN THE TEST ENGINE ---
router = OllamaFleetRouter()
test_prompt = "Need to check the narrative tracking continuity for the autonomous ship."
print(router.route_request(test_prompt))